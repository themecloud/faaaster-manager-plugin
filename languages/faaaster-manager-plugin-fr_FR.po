msgid_plural "%d addresses"
msgstr[0] "%d adresse"
msgstr[1] "%d adresses"

msgid "manual"
msgstr "manuelle"

msgid "done"
msgstr "faite"

msgid "failed"
msgstr "échouée"

msgid "Another page cache plugin is active (WP_CACHE and advanced-cache.php). It duplicates the server cache and can serve outdated pages: disable its page cache."
msgstr "Une autre extension de cache de pages est active (WP_CACHE et advanced-cache.php). Elle fait doublon avec le cache du serveur et peut servir des pages périmées : désactivez son cache de pages."

msgid "Detected plugins and builders"
msgstr "Extensions et constructeurs détectés"

msgid "When one of them regenerates or clears its files, the server cache is purged too."
msgstr "Quand l’un d’eux régénère ou vide ses fichiers, le cache du serveur est purgé aussi."

msgid "Plugin"
msgstr "Extension"

msgid "connected"
msgstr "connectée"

msgid "detected — covered by the global purge"
msgstr "détectée — couverte par la purge globale"

msgid "disabled"
msgstr "désactivée"

msgid "No supported plugin detected on this site."
msgstr "Aucune extension prise en charge détectée sur ce site."

msgid "Previous cache manager"
msgstr "Ancien gestionnaire de cache"

msgid "The former Server Cache (Nginx Helper) module is still loaded: this module handles purges in its place."
msgstr "L'ancien module Server Cache (Nginx Helper) est encore chargé : ce module gère les purges à sa place."

msgid "Server cache purge"
msgstr "Purge du cache du serveur"

msgid "reachable"
msgstr "disponible"

msgid "not reachable (%d)"
msgstr "indisponible (%d)"

msgid "Cloudflare edge cache"
msgstr "Cache Cloudflare"

msgid "enabled — purged with the server cache"
msgstr "activé — purgé avec le cache du serveur"

msgid "not enabled on this site"
msgstr "non activé sur ce site"

msgid "Object cache"
msgstr "Cache d'objets"

msgid "persistent (APCu)"
msgstr "persistant (APCu)"

msgid "none"
msgstr "aucun"

msgid "Last failed purge"
msgstr "Dernière purge échouée"

