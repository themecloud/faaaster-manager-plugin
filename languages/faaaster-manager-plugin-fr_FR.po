msgid_plural "%d seconds"
msgstr[0] "%d seconde"
msgstr[1] "%d secondes"

msgid "%d action of the former module is disabled."
msgid_plural "%d actions of the former module are disabled."
msgstr[0] "%d action de l'ancien module est désactivée."
msgstr[1] "%d actions de l'ancien module sont désactivées."

msgid "Technical details"
msgstr "Détails techniques"

msgid "no failure recorded"
msgstr "aucun échec enregistré"

msgid "Cascade purge"
msgstr "Purge en cascade"

msgid "Only the page of the content itself is purged when it is published, updated or removed."
msgstr "Seule la page du contenu elle-même est purgée quand il est publié, modifié ou retiré."

msgid "Pages that must not be cached"
msgstr "Pages à ne jamais mettre en cache"

msgid "Cart, checkout, customer account and pages that ask not to be cached (some forms, member areas) are never cached, whatever the durations above."
msgstr "Panier, commande, compte client et pages qui demandent à ne pas être mises en cache (certains formulaires, espaces membres) ne le sont jamais, quelles que soient les durées ci-dessus."

msgid "Always on"
msgstr "Toujours actif"

